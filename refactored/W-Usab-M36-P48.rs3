    <body>
        <segment id="1" parent="2" relname="background">This was a good read.</segment>
        <segment id="2" parent="25" relname="span">A few comments on Myth #6 and #7.</segment>
        <segment id="3" parent="17" relname="preparation">Myth #6:</segment>
        <segment id="4" parent="17" relname="span">Usability testing is not needed if the development team has been working with the users a long time and knows what they want.</segment>
        <segment id="5" parent="18" relname="span">I disagree with this.</segment>
        <segment id="6" parent="19" relname="span">Usability testing should always be planned.</segment>
        <segment id="7" parent="20" relname="conjunction">There are always changes</segment>
        <segment id="8" parent="21" relname="span">and they need to be aware of this</segment>
        <segment id="9" parent="8" relname="circumstance">as the project is being developed.</segment>
        <segment id="10" parent="23" relname="preparation">Myth #7:</segment>
        <segment id="11" parent="23" relname="span">"We'll handle that in the help/training/documentation."</segment>
        <segment id="12" parent="24" relname="span">This is great.</segment>
        <segment id="13" parent="12" relname="elaboration">This just says to forget about it for now and save the problem for later.</segment>
        <group id="14" type="span"/>
        <group id="15" type="multinuc" parent="14" relname="span"/>
        <group id="16" type="span" parent="15" relname="list"/>
        <group id="17" type="span" parent="16" relname="span"/>
        <group id="18" type="span" parent="4" relname="evaluation"/>
        <group id="19" type="span" parent="5" relname="elaboration"/>
