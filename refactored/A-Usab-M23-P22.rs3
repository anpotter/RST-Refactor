            <rel name="preparation" type="rst"/>
            <rel name="contrast" type="multinuc"/>
        </relations>
    </header>
    <body>
        <segment id="1" parent="12" relname="preparation">You have made an interesting point.</segment>
        <segment id="2" parent="18" relname="span">From what I have been able to ascertain from the readings and research, the HCI community has recognized that there are many types of users and has developed the concept of universal usability.</segment>
        <segment id="3" parent="2" relname="elaboration">Universal usability implies that an interface is usable by all user types.</segment>
        <segment id="4" parent="18" relname="elaboration">Universal usability is very difficult to accomplish.</segment>
        <segment id="5" parent="14" relname="span">Microsoft Word is a good example.</segment>
        <segment id="6" parent="15" relname="span">There are hundreds of features in MS Word,</segment>
        <segment id="7" parent="16" relname="contrast">some users only use a few of the features</segment>
        <segment id="8" parent="16" relname="contrast">and other users use many of the features.</segment>
        <segment id="9" parent="17" relname="span">Microsoft has attempted to make Word universally usable by making it highly customizable.</segment>
        <segment id="10" parent="9" relname="elaboration">Whether or not they have achieved universal usability is another matter.</segment>
        <group id="11" type="span"/>
        <group id="12" type="span" parent="11" relname="span"/>
        <group id="13" type="span" parent="12" relname="span"/>
        <group id="14" type="span" parent="19" relname="span"/>
        <group id="15" type="span" parent="5" relname="elaboration"/>
        <group id="16" type="multinuc" parent="6" relname="elaboration"/>
        <group id="17" type="span" parent="14" relname="elaboration"/>
        <group id="18" type="span" parent="13" relname="span"/>
        <group id="19" type="span" parent="13" relname="elaboration"/>
    </body>
</rst>
