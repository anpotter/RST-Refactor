    <body>
        <segment id="1" parent="24" relname="background">Global warming is not a myth and will destroy the planet.</segment>
        <segment id="2" parent="25" relname="span">A way to prevent this is to raise petrol prices, then people will buy less fuel and become more fuel-efficient.</segment>
        <segment id="3" parent="4" relname="cause">Raising petrol prices will make people think before they drive.</segment>
        <segment id="4" parent="28" relname="span">People will drive less and choose altematives.</segment>
        <segment id="5" parent="28" relname="result">This would reduce carbon emissions and be cheaper.</segment>
        <segment id="6" parent="26" relname="preparation">Is driving essential?</segment>
        <segment id="7" parent="8" relname="solutionhood">The planet will die.</segment>
        <segment id="8" parent="26" relname="span">Increasing petrol prices will help to stop the planet dieing.</segment>
        <segment id="9" parent="10" relname="motivation">There are cheap and readily-available alternatives to car travel.</segment>
        <segment id="10" parent="32" relname="span">Change to a mode of transport that uses less petrol!.</segment>
        <segment id="11" parent="32" relname="motivation">You will feel better, and your children will live in a better world.</segment>
        <segment id="12" parent="34" relname="concession">Some car rides are essential.</segment>
        <segment id="13" parent="34" relname="span">But think before you drive!</segment>
        <segment id="14" parent="13" relname="motivation">You could save money and reduce vour carbon output.</segment>
        <segment id="15" parent="16" relname="evidence">Petrol isn't essential to your daily life.</segment>
        <segment id="16" parent="21" relname="span">Petrol price increases shouldn't affect you.</segment>
        <segment id="17" parent="18" relname="result">Reduced petrol use will help save the planet.</segment>
        <segment id="18" parent="22" relname="span">Petrol prices should be raised</segment>
        <group id="19" type="span"/>
