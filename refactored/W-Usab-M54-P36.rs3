<?xml version="1.0" ?>
<rst>
    <header>
        <relations>
            <rel name="antithesis" type="rst"/>
            <rel name="concession" type="rst"/>
            <rel name="condition" type="rst"/>
            <rel name="evidence" type="rst"/>
            <rel name="summary" type="rst"/>
        </relations>
    </header>
    <body>
        <segment id="1" parent="11" relname="span">Staying with the credit card example, another inconsistency I run intofrequently is in entering the expiration date.</segment>
        <segment id="2" parent="12" relname="span">All of my credit cardsdisplay the expiration date mm/yy</segment>
        <segment id="3" parent="4" relname="condition">yet invariably if there is a dropdownbox on the form,</segment>
        <segment id="4" parent="13" relname="span">the months are spelled out.</segment>
        <segment id="5" parent="6" relname="concession">It's not a huge issue,</segment>
        <segment id="6" parent="14" relname="span">butit doesn't make sense to have the user choose the name of the monthassociated with the month number on the credit card.</segment>
        <segment id="7" parent="8" relname="antithesis">This is not onlyinconsistent with the real world,</segment>
        <segment id="8" parent="15" relname="span">it's an extra step and another placefor a mistake to be made.</segment>
        <group id="9" type="span"/>
        <group id="10" type="span" parent="9" relname="span"/>
        <group id="11" type="span" parent="10" relname="span"/>
        <group id="12" type="span" parent="1" relname="evidence"/>
        <group id="13" type="span" parent="2" relname="antithesis"/>
        <group id="14" type="span" parent="11" relname="evidence"/>
        <group id="15" type="span" parent="10" relname="summary"/>
    </body>
</rst>
