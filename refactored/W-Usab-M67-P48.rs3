    <body>
        <segment id="1" parent="7" relname="preparation">P30, You mention an interesting point here, regarding consistency.</segment>
        <segment id="2" parent="7" relname="span">The Microsoft Office family allows the user to work within a world that is already familiar to them.</segment>
        <segment id="3" parent="8" relname="span">Most of the menus and options within the Office Products are the same.</segment>
        <segment id="4" parent="9" relname="span">This is quite an advantage for a user who needs to learn Powerpoint quickly</segment>
        <segment id="5" parent="4" relname="circumstance">if they already know Excel.</segment>
        <group id="6" type="span"/>
        <group id="7" type="span" parent="6" relname="span"/>
        <group id="8" type="span" parent="2" relname="elaboration"/>
        <group id="9" type="span" parent="3" relname="evaluation"/>
    </body>
</rst>
