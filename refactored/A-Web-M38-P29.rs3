    <body>
        <segment id="1" parent="2" relname="volitional-cause">I am on the Web a lot</segment>
        <segment id="2" parent="21" relname="span">whether it be for work, school, banking or personal use.</segment>
        <segment id="3" parent="16" relname="span">The way a web site is designed will determine if I use it or not.</segment>
        <segment id="4" parent="18" relname="conjunction">If I am looking for information</segment>
        <segment id="5" parent="18" relname="conjunction">and I cannot find it,</segment>
        <segment id="6" parent="17" relname="span">I will quickly go to another.</segment>
        <segment id="7" parent="8" relname="condition">When purchasing items online, if it requires too much trouble and navigation</segment>
        <segment id="8" parent="19" relname="span">I will not purchase from that company.</segment>
        <segment id="9" parent="10" relname="condition">If the online banking with my current bank was not so easy to use and made life easier for me,</segment>
        <segment id="10" parent="20" relname="span">I would have probably taken my business elsewhere by now.</segment>
        <segment id="11" parent="13" relname="summary">The way a website is designed will determine who will use it.</segment>
        <group id="12" type="span"/>
        <group id="13" type="span" parent="12" relname="span"/>
        <group id="14" type="span" parent="13" relname="span"/>
        <group id="15" type="span" parent="14" relname="span"/>
        <group id="16" type="span" parent="15" relname="span"/>
        <group id="17" type="span" parent="3" relname="elaboration"/>
        <group id="18" type="multinuc" parent="6" relname="condition"/>
        <group id="19" type="span" parent="16" relname="elaboration"/>
        <group id="20" type="span" parent="15" relname="elaboration"/>
        <group id="21" type="span" parent="14" relname="background"/>
    </body>
