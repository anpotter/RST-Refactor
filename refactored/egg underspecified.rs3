    <body>
        <segment id="1" parent="14" relname="span">Unfortunately, the Dutch animal shelters fill to the brim with homeless animals every summer</segment>
        <segment id="2" parent="1" relname="elaboration">Animals that have been dine away with by their owner for whatever reason and that are now left to their destiny.</segment>
        <segment id="3" parent="10" relname="span">It is in your name we ask their help.</segment>
        <segment id="4" parent="12" relname="solutionhood">Because to improve the existence of these animals,</segment>
        <segment id="5" parent="12" relname="span">there is of course a need of money.</segment>
        <segment id="6" parent="13" relname="list">For vaccinations and sterilisations.</segment>
        <segment id="7" parent="13" relname="list">For increase of the number of shelters.</segment>
        <segment id="8" parent="13" relname="list">For extra medical cate when necessary.</segment>
        <group id="9" type="span"/>
        <group id="10" type="span" parent="9" relname="span"/>
        <group id="11" type="span" parent="3" relname="justify"/>
        <group id="12" type="span" parent="11" relname="span"/>
        <group id="13" type="multinuc" parent="5" relname="background"/>
        <group id="14" type="span" parent="10" relname="circumstance"/>
    </body>
