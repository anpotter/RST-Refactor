            <rel name="elaboration" type="rst"/>
            <rel name="otherwise" type="rst"/>
            <rel name="volitional-cause" type="rst"/>
        </relations>
    </header>
    <body>
        <segment id="1" parent="20" relname="span">A good system should, ideally, be able to recover from errors with no user intervention</segment>
        <segment id="2" parent="34" relname="span">- otherwise it becomes "error reporting"</segment>
        <segment id="3" parent="2" relname="condition">if it waits for a user to take action.</segment>
        <segment id="4" parent="34" relname="elaboration">Practically, very minimal user intervention should occur.</segment>
        <segment id="5" parent="21" relname="background">I love to pick on Windows.</segment>
        <segment id="6" parent="27" relname="volitional-cause">Remember the famous Windows95,98 error message "THIS PROGRAM HAS PERFOMED AN ILLEGAL OPERATION"</segment>
        <segment id="7" parent="27" relname="span">- so? .</segment>
        <segment id="8" parent="31" relname="span">That message was very uninformatives</segment>
        <segment id="9" parent="10" relname="volitional-cause">and just for curiosity's sake, if you click the DETAILS button,</segment>
        <segment id="10" parent="30" relname="span">you would get a bunch of meaningless number.</segment>
        <segment id="11" parent="29" relname="span">So why display the error message</segment>
        <segment id="12" parent="11" relname="circumstance">if the details further confuse the user?</segment>
        <segment id="13" parent="32" relname="span">Microsoft apparently did a very good job with Windows XP.</segment>
        <segment id="14" parent="15" relname="circumstance">If you get an error message on Windows XP,</segment>
        <segment id="15" parent="26" relname="span">mostly its; "WINDOWS HAS RECOVERED FROM A SERIOUS ERROR".</segment>
        <segment id="16" parent="24" relname="span">Thats much better!</segment>
        <segment id="17" parent="25" relname="span">all I need is to keep working,</segment>
        <segment id="18" parent="17" relname="antithesis">not to stop and wonder what I should do with an error message.</segment>
        <group id="19" type="span"/>
        <group id="20" type="span" parent="19" relname="span"/>
        <group id="21" type="span" parent="35" relname="span"/>
        <group id="22" type="span" parent="21" relname="span"/>
        <group id="23" type="span" parent="13" relname="elaboration"/>
        <group id="24" type="span" parent="23" relname="span"/>
        <group id="25" type="span" parent="16" relname="elaboration"/>
        <group id="26" type="span" parent="24" relname="volitional-cause"/>
        <group id="27" type="span" parent="22" relname="span"/>
        <group id="28" type="span" parent="7" relname="elaboration"/>
        <group id="29" type="span" parent="28" relname="span"/>
        <group id="30" type="span" parent="8" relname="elaboration"/>
        <group id="31" type="span" parent="29" relname="antithesis"/>
        <group id="32" type="span" parent="22" relname="concession"/>
        <group id="33" type="span" parent="1" relname="otherwise"/>
